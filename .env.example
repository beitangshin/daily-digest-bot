# 复制这个文件为 .env，并填入你自己的 DeepSeek API key。
# .env 已经在 .gitignore 中被忽略，不会被提交到 git。

# 必填：在 https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=

# 一般不需要改动：
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名称会随 DeepSeek 更新，deepseek-chat 是官方维持的"当前主力对话模型"别名。
# 运行前可到 https://api-docs.deepseek.com/quick_start/pricing 确认当前可用的模型名。
DEEPSEEK_MODEL=deepseek-chat

# 用于展示、以及给没有时区信息的日期兜底假定的时区
DIGEST_TIMEZONE=Asia/Shanghai

# 摘要输出语言，目前 prompt 是按中文（zh）设计的
DIGEST_LANGUAGE=zh

# 没有发布时间的文章（多为 html 兜底抓取得到）是否仍然收录
INCLUDE_UNDATED_ARTICLES=false

# 每个频道只抓"自上次成功运行以来"新发布的文章，不是"今天"（按日历日过滤会有漏洞：
# 定时任务跑完之后到午夜之间发布的内容会永远进不了任何一天的简报，详见 MAINTENANCE.md）。
# 第一次跑（还没有上次运行记录）时，往回看多少小时：
FIRST_RUN_LOOKBACK_HOURS=24
# 如果距离上次运行已经隔了很久（比如设备关机了几天），最多往回补多少小时，避免一次性
# 涌入一大堆积压内容：
MAX_LOOKBACK_HOURS=72

# 并发与批处理参数，一般不用改
MAX_CONCURRENT_FETCHES=8
MAX_CONCURRENT_LLM_CALLS=3
ARTICLES_PER_LLM_BATCH=6
MAX_HTML_FALLBACK_LINKS=20
REQUEST_TIMEOUT_SECONDS=20
